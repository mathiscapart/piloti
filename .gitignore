# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/backups

# misc
.DS_Store
*.pem

# pnpm local store (si configuré en local dans le projet)
.pnpm-store

# Claude Code (mémoire locale, fichiers de session)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Exception : le gabarit ne contient que des valeurs d'exemple, et il doit être
# versionné — sinon personne ne sait quelles variables l'application attend.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma / sqlite (la DB vit à la racine en dev — cf. prisma.config.ts)
# Filet large : seul `/dev.db` était couvert, or une base committée exposerait
# les hashs de mots de passe. Toute base SQLite locale est ignorée, quel que
# soit son nom (bases de test, worktrees) et qu'elle soit à la racine ou dans
# prisma/ (un DATABASE_URL qui pointe là est vite écrit).
*.db
*.db-journal
*.db-wal
*.db-shm

# uploads (Phase 7) — stockés hors de public/ (contrôle d'accès, cf. lib/upload.ts)
/var/uploads/
